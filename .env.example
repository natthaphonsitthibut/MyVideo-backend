# Copy to .env and fill in. Never commit .env. Names are provider-neutral on purpose.
NODE_ENV=development
PORT=3000
# Logs: fatal|error|warn|info|debug|trace|silent ; LOG_PRETTY=true for human-readable dev logs
LOG_LEVEL=info
LOG_PRETTY=false
# Native services (default, ../scripts/dev-services.sh):
DATABASE_URL=postgresql://localhost:5432/myvideo_dev
TEST_DATABASE_URL=postgresql://localhost:5432/myvideo_test
# Docker services (docker compose up -d) use instead:
# DATABASE_URL=postgresql://myvideo:myvideo@localhost:5432/myvideo_dev
# TEST_DATABASE_URL=postgresql://myvideo:myvideo@localhost:5432/myvideo_test
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me

# Storage: local (dev) | s3 (production, any S3-compatible service)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
UPLOAD_TMP_DIR=.data/uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI service (Python) and speech-to-text engine (chosen in E01)
AI_SERVICE_URL=http://127.0.0.1:8000
ASR_ENGINE=

# LLM is used only to analyse transcripts/keyframes (no chatbot, no agent at runtime).
# LLM_MODE: api = hosted LLM API (production) | local-agent = local coding-agent CLI (development) | rules = no LLM
# LLM_PROVIDER names the API adapter to use in api mode (one adapter per provider; the app is not tied to one vendor).
# LOCAL_AGENT_CLI is the command used in local-agent mode (for example: claude or codex).
LLM_MODE=local-agent
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_FAST=
LLM_MODEL_SMART=
LOCAL_AGENT_CLI=claude
LLM_MAX_CALLS_PER_RUN=50

# Limits (dev machine has 8 GB RAM: keep concurrency at 1)
UPLOAD_MAX_BYTES=8589934592
QUEUE_PREFIX=myvideo
MERCHANT_MAX_INFLIGHT_JOBS=2
MERCHANT_MAX_ACTIVE_RUNS=20
JOB_HEARTBEAT_MS=2000
JOB_STALE_AFTER_MS=30000
JOB_LOST_AFTER_MS=30000
DISPATCH_POLL_MS=500
QUEUE_MEDIA_CONCURRENCY=1
QUEUE_AI_CONCURRENCY=1
QUEUE_RENDER_CONCURRENCY=1

# Dev seed (pnpm db:seed). Without SEED_USER_PASSWORD a fixed dev-only password is used; required in production.
SEED_MERCHANT_NAME=
SEED_MERCHANT_SLUG=
SEED_USER_EMAIL=
SEED_USER_NAME=
SEED_USER_PASSWORD=
